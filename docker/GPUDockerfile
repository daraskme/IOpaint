FROM node:22-bookworm-slim AS web-builder

WORKDIR /src/web_app
COPY web_app/package.json web_app/package-lock.json ./
RUN npm ci
COPY web_app/ ./
RUN npm run build

FROM nvidia/cuda:12.8.2-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    ffmpeg \
    libfontconfig1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv \
    && python -m pip install --no-cache-dir --upgrade pip

# PyTorch is by far the largest layer; install it before copying sources so
# that source-only changes do not invalidate it.
RUN python -m pip install --no-cache-dir torch torchvision \
      --index-url https://download.pytorch.org/whl/cu128

WORKDIR /opt/iopaint
COPY . .
RUN rm -rf iopaint/web_app && mkdir -p iopaint/web_app
COPY --from=web-builder /src/web_app/dist/ ./iopaint/web_app/

RUN python -m pip install --no-cache-dir .

EXPOSE 8080

ENTRYPOINT ["iopaint", "start", "--host", "0.0.0.0"]
CMD ["--device", "cuda", "--port", "8080"]
